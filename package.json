{
  "name": "nimbywatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "ingest": "node --import tsx scripts/ingest.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "analyze": "node --import tsx scripts/analyze.ts",
    "prepare": "node scripts/prepare-assets.mjs",
    "format": "prettier --write src scripts tests migrations *.ts *.mjs *.json docs/*.md README.md AGENTS.md",
    "housing:extract": "node --import tsx scripts/extract-housing.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@next/env": "^16.4.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "mapbox-gl": "^3.33.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
