# PostgreSQL connection string for production (Supabase direct/session pooler URI).
# Leave unset locally to use persistent PGlite in .data/postgres.
# Vercel deployment requires DATABASE_URL; local files are not durable there.
DATABASE_URL=
# Optional local-only override. One process per PGlite directory.
PGLITE_DATA_DIR=

# Public browser token; restrict allowed URLs in your Mapbox account.
# With no token, the app uses the documented CARTO vector basemap via MapLibre.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional alternate MapLibre style URL (no effect on the Mapbox token path).
NEXT_PUBLIC_MAP_STYLE_URL=

# Server-side only. Use secure OpenAI key setup; never NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# At least 24 random characters. Only trusted reviewers should know this token.
ADMIN_TOKEN=
# Hard per-document reservation and daily reserved-spend ceiling, USD.
AI_MAX_DOCUMENT_USD=0.10
AI_DAILY_BUDGET_USD=1

# Optional: Socrata application token for higher documented API rate limits.
SOCRATA_APP_TOKEN=
